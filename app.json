{
  "expo": {
    "name": "Expense Splitter",
    "slug": "expense-splitter",
    "scheme": "expensesplitter",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "in.ssoftapp.split",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "split.ssoftapp.in",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/with-upi-queries"
    ]
  }
}