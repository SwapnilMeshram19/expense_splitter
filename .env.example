# Expo picks env files by build mode (development for `npm start` / dev client, production for
# release bundles). Earlier files win:
#   development: .env.development.local, .env.local, .env.development, .env
#   production:  .env.production.local,  .env.local, .env.production,  .env
#
# Copy this to .env.development.local (gitignored), then restart with `npx expo start -c`. Dev builds
# and release builds use the same Supabase project; release builds get the values from CI secrets,
# written to .env.production.local by the release workflow.
#
# Avoid plain .env.local: it's loaded in BOTH modes, so a release bundle built on this machine would
# silently pick up whatever it holds unless .env.production.local exists.
#
# Public values only (they end up in the APK). Never the secret / service-role key.

# Project URL only, no path (not …/rest/v1/).
EXPO_PUBLIC_SUPABASE_URL=https://cudmaszrwrbgwsoizajd.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uT0-HFL_r5ECzlUVJdP-Ng_gzp8VaMF
# Google Cloud → Credentials → the WEB client (the ID token's audience), not an Android client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com

# AdMob banner units: production only (.env.production.local / CI). Development builds always use
# Google's test units, whatever is set here. See docs/ads.md.
# EXPO_PUBLIC_ADMOB_HOME_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_ACTIVITY_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# The AdMob App ID is read by app.config.ts at build time (not EXPO_PUBLIC_):
# ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
